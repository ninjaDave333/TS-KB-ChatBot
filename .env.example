# AWS Bedrock Configuration
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Neo4j Database Configuration (Docker network)
NEO4J_URI=bolt://Neo4jSrv:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password

# PostgreSQL Configuration (for future integration)
POSTGRES_HOST=my-postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_password
POSTGRES_DB=meetingsBot_results

# ChromaDB Configuration (for future integration)
CHROMA_HOST=ChromaDB
CHROMA_PORT=8000

# Application Configuration
GRAPH_CACHE_ENABLED=false
LOG_LEVEL=INFO